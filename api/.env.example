PORT=3000

# Replace the placeholders in your local .env and percent-encode special characters.
DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@localhost:5432/DB_NAME

# Set privately to a random signing secret of at least 32 bytes.
JWT_SECRET=

# Public web origin used in shareable marketer referral URLs. Use the reachable web origin for Expo.
WEB_BASE_URL=http://localhost:3001

# Cashback unlock thresholds. Spend is in hundredths of a new SYP.
CASHBACK_MILESTONE_PURCHASES=5
CASHBACK_MILESTONE_SPEND_SYP=50000

# Local demo seed only. Supply values privately. Opt in to the named development DB per shell.
ALLOW_DEV_DEMO_SEED=
DEMO_SEED_DATABASE_URL=
DEMO_ADMIN_PASSWORD=
DEMO_ACCOUNT_PASSWORD=
